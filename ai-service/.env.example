# Copy this file to .env and replace the service token.
# Do not put AWS access keys here. Use an AWS profile or an IAM role.

HOST=127.0.0.1
PORT=8000
AWS_REGION=ap-south-1
# In ap-south-1, Nova Lite must be called through this inference profile.
# The foundation model ID amazon.nova-lite-v1:0 is rejected for on-demand use.
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
MAX_DOCUMENT_CHARACTERS=200000
MAX_OUTPUT_TOKENS=800
PYTHON_SERVICE_TOKEN=replace-with-a-long-random-token

# Optional. Defaults to 10. Keep this aligned with the Express MAX_FILE_SIZE_MB value.
MAX_UPLOAD_MB=10
