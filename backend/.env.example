# Copy this file to .env and replace the service token.
# Use the same PYTHON_SERVICE_TOKEN value in the Python service.

PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/ai_document_summarizer
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_TOKEN=replace-with-a-long-random-token
FRONTEND_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=10
